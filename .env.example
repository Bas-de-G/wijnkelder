# Supabase — te vinden onder Project Settings → API.
# Deze twee waarden zijn bedoeld om publiek te zijn: ze komen in de browser
# terecht en geven op zichzelf geen toegang. Row Level Security doet het echte werk.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Optioneel. Zonder deze regel gebruikt de app het adres waarop hij draait, en dat
# is meestal wat je wilt — ook voor Vercel-previews, die elke keer een ander adres
# krijgen. Zet 'm alleen als inloglinks altijd naar één vast domein moeten wijzen.
# NEXT_PUBLIC_SITE_URL=https://wijnkelder.example.nl
